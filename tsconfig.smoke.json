{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "/tmp/icv-test",
    "rootDir": "./src"
  },
  "include": ["src/v1/**/*.ts", "src/types/globals.d.ts"],
  "exclude": ["src/v1/main.ts"]
}
