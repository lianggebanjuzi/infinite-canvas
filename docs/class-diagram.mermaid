classDiagram
  class FlowNode {
    +string id
    +NodeType type
    +number x
    +number y
    +number ratio
    +NodeStatus status
    +string title
    +Record~string, unknown~ params
    +string imageUrl
    +ImageOrigin imageOrigin
    +string outputText
    +TextGenHistoryItem[] textHistory
    +string[] refImages
    +string error
    +number lastRunAt
    +string parentId
    +GenerationTrace trace
    +boolean isAsset
  }
  class FlowEdge {
    +string id
    +string from
    +string to
  }
  class FlowState {
    +FlowNode[] nodes
    +FlowEdge[] edges
    +getNode(id)
    +getUpstreams(id)
    +getDownstreams(id)
    +getAllDownstreams(id)
    +getUpstreamTextPrompts(id)
    +isAsset(id)
    +isAssetNode(node)
    +getReferenceImages(id)
    +canConnect(from, to)
    +connect(from, to)
    +addEdge(from, to, opts)
    +insertStep(edgeId)
    +addNode(type, x, y, extra)
    +removeNode(id)
    +pushTextHistory(id, text)
    +removeChildren(parentId)
  }
  class RunEngine {
    -busy
    +run(nodeId)
    +runSelected()
    +runAll(ids)
    +runOutpaint(nodeId, opts)
    +composeImagePrompt(nodeId)
    -runTextGen(nodeId)
    -runBatch(nodeId)
    -runOneWorker(...)
    -_writeBackToSelf(genId, imageUrl, origin, batchId, outputType)
    -createResultCard(...)
  }
  class NodeDefinition {
    +NodeType type
    +canRun(node, ctx)
    +buildOptions(node, ctx)
    +creatable
  }
  class ImageGenDef
  class TextGenDef
  class NodeRegistry {
    +register(def)
    +get(type)
    +list()
  }
  class CmdPanel {
    +sync()
    -_openImageModelMenu(btn, node)
    -_renderChips(node)
    -_refillHistoryItem(nodeId, item)
    -_renderRefs()
  }
  class CardView {
    +renderAll()
    -buildCard(node)
    -updateCard(el, node)
    -_commitTextEdit(nodeId, ta)
    -_enterTextEdit(nodeId)
  }
  class Interactions {
    -_dropImage(src, world, screenX, screenY)
    -_showNewNodeMenu(x, y, fromId)
    -_showCardMenu(x, y, node)
    -_bindFileInput()
    -_finishConnect(e)
  }
  class DirtyMarker {
    +markUpstreamChanged(fromId)
    +markStale(nodeId)
    +markUpstreamChangedExcept(fromId, exceptIds)
  }
  class Persistence {
    +collect()
    +restore(raw)
    -migrateNode(raw)
  }
  FlowState "1" *-- "many" FlowNode
  FlowState "1" *-- "many" FlowEdge
  ImageGenDef ..|> NodeDefinition : implements
  TextGenDef ..|> NodeDefinition : implements
  NodeRegistry o-- NodeDefinition
  RunEngine ..> FlowState : uses
  RunEngine ..> DirtyMarker : uses
  RunEngine ..> NodeRegistry : uses
  CmdPanel ..> FlowState : uses
  CmdPanel ..> RunEngine : uses
  CardView ..> FlowState : uses
  CardView ..> DirtyMarker : uses
  Interactions ..> FlowState : uses
  Interactions ..> CardView : uses
  Interactions ..> NodeRegistry : uses
  Persistence ..> FlowState : uses
