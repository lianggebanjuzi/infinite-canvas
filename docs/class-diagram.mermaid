classDiagram
    class FlowNode {
        +id: string
        +type: NodeType
        +x: number
        +y: number
        +ratio: number
        +status: NodeStatus
        +title: string
        +params: Record~string,unknown~
        +imageUrl: string | null
        +refImages: string[]
        +error: string | null
        +lastRunAt: number | null
    }

    class FlowEdge {
        +id: string
        +from: string
        +to: string
    }

    class NodeDefinition {
        +type: NodeType
        +label: string
        +defaultTitle: string
        +defaultRatio: number
        +defaultParams: Record~string,unknown~
        +canRun(node, ctx) boolean | string
        +buildOptions(node, ctx) Record~string,unknown~
    }

    class FlowContext {
        +getUpstreams(nodeId) FlowNode[]
        +getDownstreams(nodeId) FlowNode[]
        +getReferenceImages(nodeId) string[]
        +getImageModels() Promise
    }

    class FlowState {
        +nodes: FlowNode[]
        +edges: FlowEdge[]
        +addNode(type, x, y, extra) FlowNode
        +getReferenceImages(id) string[]
        +addRefImage(id, url) void
        +removeRefImage(id, url) void
        +canConnect(from, to) string | null
        +_wouldCycle(from, to) boolean
        +addEdge(from, to) FlowEdge | null
        +insertStep(edgeId) FlowNode | null
        +removeEdge(id) void
    }

    class RunEngine {
        +run(nodeId) Promise
        +runSelected() Promise
        +runAll(ids?) Promise
    }

    class Persistence {
        +collect() FlowProject
        +restore(raw) boolean
        +migrateNode(raw) FlowNode | null
        +save() Promise
        +open() Promise
    }

    FlowState "1" *-- "0..N" FlowNode : 持有
    FlowState "1" *-- "0..N" FlowEdge : 持有
    FlowContext --> FlowState : 读取
    RunEngine --> FlowState : 读写
    RunEngine --> NodeDefinition : canRun/buildOptions
    Persistence --> FlowState : replaceAll
    FlowNode ..> NodeDefinition : type 映射到定义
